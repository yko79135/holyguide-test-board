# Neon Postgres connection string. Required — the app will not start without it.
# Get it from https://console.neon.tech → your project → Connection Details (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Google OAuth Web client ID (console.cloud.google.com/apis/credentials).
# The deployment origin must be listed as an Authorized JavaScript origin.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# The single account treated as the teacher. Everyone else must be on the students table.
TEACHER_EMAIL=yko79135@gmail.com
