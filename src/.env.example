# ---------------------------------------------------------------------
# Required. Without this the API cannot start.
# ---------------------------------------------------------------------

# Supabase Postgres connection string.
#
# It must be a POOLER URI, not the direct one: db.<ref>.supabase.co has no
# A record (it is IPv6-only) and will not resolve from a Vercel function.
# Supabase dashboard -> Connect -> Transaction pooler. Port 6543, and the
# user carries the project ref, as postgres.<ref>.
#
# The password is the database password, set or reset under
# Settings -> Database. It is shown once; rotating it there is also how you
# revoke this string.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# Optional. TLS is always on; supplying the pooler's CA certificate turns on
# full verification of it as well. Without this the connection is encrypted
# but the server's certificate is not checked. Supabase dashboard ->
# Settings -> Database -> SSL configuration.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n"

# ---------------------------------------------------------------------
# Optional. Each block is inert if left unset — the board keeps working,
# it just stops doing that one thing.
# ---------------------------------------------------------------------

# Google sign-in. Has a working default baked in; set it only to move
# the board to a different OAuth client.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# The single account with teacher powers. Everyone else must be a row in
# the students table.
TEACHER_EMAIL=yko79135@gmail.com

# --- Google Calendar: approved tests become events --------------------
# A service account, not an OAuth user. Create one in the same Google
# Cloud project, enable the Calendar API, download a JSON key, then
# share the target calendar with the service account's address giving it
# "Make changes to events". Sharing is the step people forget: without
# it every insert comes back 404.
GOOGLE_SA_EMAIL=test-board@your-project.iam.gserviceaccount.com
# The "private_key" field from that JSON, verbatim, newlines and all.
# Literal \n sequences are unescaped at startup, so either form works.
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Which calendar to write to. For a personal Google account this is your
# own address — "primary" would mean the service account's own calendar,
# which nobody can see.
CALENDAR_ID=yko79135@gmail.com

# --- Email: a new proposal pings the teacher --------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
# Any verified sender. resend.dev's onboarding address works without a
# domain, but only to the address that owns the Resend account.
NOTIFY_FROM=Test Date Board <onboarding@resend.dev>
# Defaults to TEACHER_EMAIL.
NOTIFY_EMAIL=yko79135@gmail.com

# Used in the email body and the calendar event's source link.
APP_URL=https://holyguide-test-board.vercel.app
